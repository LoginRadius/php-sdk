{
    "name": "loginradius/php-sdk",
    "description": "Official PHP SDK for the LoginRadius Customer Identity and Access Management (CIAM) platform.",
    "homepage": "https://www.loginradius.com",
    "license": "MIT",
    "authors": [
        {
            "name": "LoginRadius",
            "homepage": "https://www.loginradius.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "LoginRadius\\Sdk\\Internal\\OpenApi\\": "src/Internal/OpenApi/",
            "LoginRadius\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LoginRadius\\Sdk\\Internal\\OpenApi\\Test\\": "test/",
            "LoginRadius\\Sdk\\Demo\\": "demo/",
            "LoginRadius\\Sdk\\Tests\\": "tests/"
        }
    },
    "version": "12.0.0-rc.1"
}
